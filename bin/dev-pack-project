source ./bin/dev-set &&
  source ./bin/dev-source-base &&
  source ./bin/dev-env-project &&
  source ./bin/dev-env-docker &&
  source ./bin/dev-env-cosign || exit 1

declare MY_CATALOG="${1:-$DEV_PACK_PROJECT_PATH_SOURCE}"
declare MY_PUBLISH="${2:-${BL64_VAR_OFF}}"
declare MY_RESET="${3:-${BL64_VAR_OFF}}"

# Build / Project / Parameters
export CNTBUILD_REGISTRY="$DEV_AUTH_DOCKER_REGISTRY"
export CNTBUILD_COSIGN_BIN="$DEV_LIB_COSIGN_BIN"

function my_pack() {
  bl64_dbg_app_show_function
  local container_name=''
  local image_list="${DEV_PACK_PROJECT_LIST_PREFIX}${MY_CATALOG}"
  local -i pause=5

  bl64_msg_show_phase "processing container list (${image_list})"
  # shellcheck disable=SC2086
  for container_name in ${!image_list}; do
    "$DEV_LIB_PROJECT_BIN" -b -c "$container_name" &&
      sleep $pause ||
      return $?
    if bl64_lib_flag_is_enabled "$MY_PUBLISH"; then
      if bl64_lib_flag_is_enabled "$MY_RESET"; then
        "$DEV_LIB_PROJECT_BIN" -x -c "$container_name"
      fi
      "$DEV_LIB_PROJECT_BIN" -u -c "$container_name" &&
        sleep $pause ||
        return $?
    fi
  done
}

function my_initialize() {
  bl64_dbg_app_show_function
  dev_base_task_initialize &&
    bl64_check_parameter 'MY_CATALOG' ||
    return $?

  if [[ ! -v "${DEV_PACK_PROJECT_LIST_PREFIX}${MY_CATALOG}" ]]; then
    bl64_msg_show_error "invalid build target. Container list not found (${MY_CATALOG} -> ${DEV_PACK_PROJECT_LIST_PREFIX}${MY_CATALOG})"
    return 1
  fi

  dev_base_task_show_setup \
    'DEV_PACK_PROJECT_PATH_TARGET' \
    'MY_CATALOG' \
    'MY_PUBLISH' \
    'MY_RESET'
}

bl64_lib_script_version_set '4.0.0'
bl64_msg_help_set_about 'Pack application for release'
dev_base_initialize && my_initialize || exit $?

bl64_msg_show_batch_start "$BL64_SCRIPT_ID"
my_pack
bl64_msg_show_batch_finish $? "$BL64_SCRIPT_ID"
